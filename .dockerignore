# Hidden VCS, editor, CI, and local tool state are not needed in the
# release-build context.
.*
untracked

# Local build products
**/.deps
**/.libs
**/autom4te.cache
**/*.o
**/*.lo
**/*.la
**/*.a
**/*.so
**/*.dylib
**/*.dll
**/*.exe
**/*.pid
**/debug.log
**/Makefile
!depends/Makefile
**/Makefile.in
**/config.log
**/config.status
**/libtool
**/stamp-h1
**/aclocal.m4
configure
configure~
build-aux/compile
build-aux/config.guess
build-aux/config.sub
build-aux/depcomp
build-aux/install-sh
build-aux/ltmain.sh
build-aux/m4/libtool.m4
build-aux/m4/ltoptions.m4
build-aux/m4/ltsugar.m4
build-aux/m4/ltversion.m4
build-aux/m4/lt~obsolete.m4
build-aux/missing
build-aux/test-driver
doc/man/Makefile
doc/man/Makefile.in
share/setup.nsi
src/Makefile
src/Makefile.in
src/config/hemp0x-config.h
src/config/hemp0x-config.h.in~
src/config/stamp-h1
src/obj/build.h

# Depends build cache/output. The Docker build recreates these from package recipes.
depends/built
depends/sources
depends/work
depends/*-pc-linux-gnu
depends/*-w64-mingw32
depends/*-apple-darwin*
depends/*-unknown-freebsd*

# Core binaries from local validation runs.
src/hemp0xd
src/hemp0x-cli
src/hemp0x-tx
src/test/test_hemp0x
src/test/test_hemp0x_fuzzy
src/test/test_hemp0x_hash
